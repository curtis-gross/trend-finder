# ==============================================================================
# Trend Finder (Multi-Channel Media Listening & Brand Intelligence) - Environment
# Copy this file to `.env` (`cp .env.example .env`) or run `npm run setup`.
# Never commit `.env` to version control.
# ==============================================================================

# Google Cloud Platform Project ID (required for Vertex AI & GCS 3-tier cache)
GCP_PROJECT=your-gcp-project-id

# Google Cloud Region (e.g., us-central1, global)
GCP_REGION=us-central1

# Google Cloud Storage bucket for run snapshots & generated media.
# Defaults to "${GCP_PROJECT}-trend-gcs" when GCP_PROJECT is set.
GCS_BUCKET_NAME=your-gcp-project-id-trend-gcs

# Active brand / tenant name displayed in the studio (overrides default test-company)
COMPANY_NAME=your-brand-name

# GenAI runtime provider for the application ("vertex" | "aistudio" | "auto").
# Keep "vertex" for production/client runs (data privacy, 4-worker concurrency, GCS).
GENAI_PROVIDER=vertex

# Vertex AI / Google Cloud API key for Gemini models (or leave blank to use gcloud ADC)
GOOGLE_CLOUD_API_KEY=

# Optional YouTube Data API v3 key (used for live YouTube video & comment harvesting)
YOUTUBE_API_KEY=

# Optional Google AI Studio Free Tier key (from https://aistudio.google.com/apikey)
# Used by `npm run setup:assist` (`gemini-3.5-flash-lite`) for redacted CLI onboarding
# before GCP/Vertex AI is configured, or when GENAI_PROVIDER=aistudio in local dev.
AI_STUDIO_API_KEY=

# Backend FastAPI server port (default: 8080; server_control.sh auto-scans 8080..8100)
PORT=8080

# Frontend Vite dev server port (default: 3000; server_control.sh auto-scans 3000..3020)
VITE_PORT=3000
