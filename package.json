{
  "name": "trend-finder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:watch": "vite build --watch --emptyOutDir false",
    "server": "./scripts/server_control.sh start",
    "dev:server": "./scripts/server_control.sh start",
    "dev:all": "./start_local.sh --yes",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "./scripts/server_control.sh start",
    "logs": "./view_logs.sh",
    "stop": "./stop_server.sh",
    "restart": "./scripts/server_control.sh restart",
    "server:status": "./scripts/server_control.sh status",
    "setup": "./scripts/configure_client.sh",
    "setup:assist": "python3 scripts/setup_assistant.py",
    "setup:gcp": "./scripts/gcp_setup.sh",
