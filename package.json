  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.6.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/recharts": "^1.8.29",
    "jsdom": "^29.0.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.0"
